{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build minishell",
            "command": "make",
            "args": [
                "-f",
                "${workspaceFolder}/Makefile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "clean minishell",
            "command": "make",
            "args": [
                "clean",
                "-f",
                "${workspaceFolder}/Makefile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "re-build minishell",
            "command": "make",
            "args": [
                "re",
                "-f",
                "${workspaceFolder}/Makefile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
